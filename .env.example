# ====================================================================
# WordPress Management CLI - Environment Configuration
# ====================================================================
# Copy this file to .env and configure with your actual values
# 
# The script uses a site-key based configuration system where each
# WordPress site has its own set of environment variables.
#
# Format: {SITE_KEY}_{ENVIRONMENT}_{TYPE}
# Example: YOURSITE_PROD_SSH, YOURSITE_STAGE_PATH, etc.
# ====================================================================

# === GLOBAL CONFIGURATION ===
# Local backup directory (default: ./backups)
LOCAL_BACKUP_DIR=./backups

# Backup retention period in days (default: 7)
BACKUP_RETENTION_DAYS=7

# === SITE-SPECIFIC CONFIGURATION ===
# Replace 'YOURSITE' with your actual site identifier (uppercase)
# You can have multiple sites by duplicating this pattern with different keys

# Example Site Configuration (replace YOURSITE with your site key)
# ====================================================================

# Production Server Configuration
YOURSITE_PROD_SSH=user@production-server.com
YOURSITE_PROD_PATH=/var/www/your-site
YOURSITE_PROD_URL=https://your-site.com

# Staging Server Configuration  
YOURSITE_STAGE_SSH=user@staging-server.com
YOURSITE_STAGE_PATH=/var/www/your-site-staging
YOURSITE_STAGE_URL=https://staging.your-site.com

# === MULTI-SITE EXAMPLE ===
# If you have multiple sites, add additional configurations:
#
# ANOTHERSITE_PROD_SSH=user@another-prod-server.com
# ANOTHERSITE_PROD_PATH=/var/www/another-site
# ANOTHERSITE_PROD_URL=https://another-site.com
# ANOTHERSITE_STAGE_SSH=user@another-staging-server.com
# ANOTHERSITE_STAGE_PATH=/var/www/another-site-staging
# ANOTHERSITE_STAGE_URL=https://staging.another-site.com

# === RESTORE OPERATION CONFIGURATION ===
# These variables are used for restore operations when you need to
# specify a target server that's different from your site configurations
REMOTE_USER=your-username
REMOTE_HOST=target-server.com
REMOTE_BACKUP_DIR=wp_backups
REMOTE_HOME_DIRECTORY=/home1/msenmsmy

# === USAGE NOTES ===
# 1. Site keys should be uppercase and descriptive (e.g., BLOG, STORE, MAIN)
# 2. SSH configurations should use key-based authentication for automation
# 3. Paths should be absolute paths on the remote servers
# 4. URLs should include the protocol (http:// or https://)
# 5. For single-server setups, you can use the same values for PROD and STAGE
# 6. The script will validate all required variables before execution
