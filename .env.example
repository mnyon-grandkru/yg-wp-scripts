# ====================================================================
# WordPress Backup and Clone Configuration Template
# --------------------------------------------------------------------
# Copy this file to .env and update the values for your environment.
# This file contains configuration variables for WordPress backup,
# restore, and staging clone operations.
# ====================================================================

# === SSH Connection Settings ===
REMOTE_USER="your_username"
REMOTE_HOST="your-server.com"

# === Production Site Configuration ===
PROD_SITE_PATH="public_html"
PROD_URL="https://your-production-site.com"
PROD_DB_NAME="production_db_name"

# === Staging Site Configuration ===
STAGING_SITE_PATH="staging_html"
STAGING_URL="https://staging.your-site.com"
STAGING_DB_NAME="staging_db_name"
STAGING_DB_HOST="localhost"
STAGING_DB_USER="staging_db_user"
STAGING_DB_PASSWORD="staging_db_password"
STAGING_ENV="staging"

# === Database Configuration ===
# These are used for both production and staging operations
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"

# === Backup Configuration ===
LOCAL_BACKUP_DIR="~/wp_backups"
REMOTE_BACKUP_DIR="wp_backups"

# === Staging Backup Configuration ===
STAGING_BACKUP_DIR="~/staging_backups"
STAGING_BACKUP_RETENTION_DAYS="7"

# === Multi-Site Configuration (for wp_backup_new.zsh) ===
# Site paths and names for multi-site backups
# Format: one path per line, one name per line
SITE_PATHS="public_html
staging_html
dev_html"

SITE_NAMES="production
staging
development"

# === Additional Settings ===
# Uncomment and modify as needed
# WP_CLI_PATH="/usr/local/bin/wp"
# SSH_KEY_PATH="~/.ssh/id_rsa"
# COMPRESSION_LEVEL="6"
